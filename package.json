{
  "name": "nakhla-residence",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "description": "NAKHLA RESIDENCE — original fictional Basra-inspired interactive 3D concept (not a real listing).",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "export:scene": "vitest run tests/unit/export-artifacts.test.ts",
    "blender": "node tools/blender.mjs blender/build_nakhla.py blender/scene_prims.json blender public/renders",
    "qa:status": "python -I tools/qa_status.py .",
    "validate:spec": "python -I spec/scripts/VALIDATE_V8_PACKAGE.py"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "license": "SEE LICENSE IN README.md"
}
